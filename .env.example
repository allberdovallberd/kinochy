PORT=4000
APP_PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-before-production
TRUST_PROXY=false
COOKIE_SECURE=false
NODE_IMAGE=public.ecr.aws/docker/library/node:22-alpine

# Leave DATABASE_URL empty to run without Docker/PostgreSQL.
# Uploaded movies and subtitles will persist in storage/data.json.
DATABASE_URL=
POSTGRES_DB=kinochy
POSTGRES_USER=kinochy
POSTGRES_PASSWORD=kinochy
POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:16-alpine

ADMIN_EMAIL=admin@kinochy.local
ADMIN_USER_NAME=Admin
ADMIN_PASSWORD=KinochyAdmin@4321!
DEFAULT_USER_NAME=Allberdov
DEFAULT_USER_EMAIL=allberdov@gmail.com
DEFAULT_USER_PASSWORD=Kinochy@4321!

# Word lookup provider. Default uses a public LibreTranslate-compatible endpoint.
# For LibreTranslate, set TRANSLATE_PROVIDER=libretranslate and optionally:
# LIBRETRANSLATE_URL=https://translate.mstdn.social/translate
# LIBRETRANSLATE_API_KEY=
TRANSLATE_PROVIDER=libretranslate
LIBRETRANSLATE_URL=https://translate.mstdn.social/translate
LIBRETRANSLATE_API_KEY=
MYMEMORY_EMAIL=

# Brevo transactional email.
# API key is preferred for local development verification emails.
BREVO_API_KEY=
BREVO_SMTP_KEY=
BREVO_SMTP_LOGIN=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SENDER_NAME=Allberdov Allberd
BREVO_SENDER_EMAIL=allberdovallberd@gmail.com
