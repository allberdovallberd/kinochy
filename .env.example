PORT=4000
APP_PORT=4000
APP_BASE_PATH=/
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-before-production
TRUST_PROXY=false
COOKIE_SECURE=false
NODE_IMAGE=public.ecr.aws/docker/library/node:22-alpine
UPLOAD_MAX_BYTES=8589934592
REQUEST_TIMEOUT_MS=0
HEADERS_TIMEOUT_MS=600000
KEEP_ALIVE_TIMEOUT_MS=65000
MEDIA_INITIAL_CHUNK_BYTES=0
VIDEO_OPTIMIZE_ON_UPLOAD=false
VIDEO_BACKGROUND_OPTIMIZE=true
VIDEO_HLS_ENABLE=true

# Leave DATABASE_URL empty to run without Docker/PostgreSQL.
# Uploaded movies and subtitles will persist in storage/data.json.
DATABASE_URL=
POSTGRES_DB=kinochy
POSTGRES_USER=kinochy
POSTGRES_PASSWORD=kinochy
POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:16-alpine

ADMIN_EMAIL=admin@kinochy.local
ADMIN_USER_NAME=Admin
ADMIN_PASSWORD=KinochyAdmin@4321!
DEFAULT_USER_NAME=Allberdov
DEFAULT_USER_EMAIL=allberdov@gmail.com
DEFAULT_USER_PASSWORD=Kinochy@4321!

# Word lookup provider. Default uses a public LibreTranslate-compatible endpoint.
# For LibreTranslate, set TRANSLATE_PROVIDER=libretranslate and optionally:
# LIBRETRANSLATE_URL=https://translate.mstdn.social/translate
# LIBRETRANSLATE_API_KEY=
TRANSLATE_PROVIDER=libretranslate
LIBRETRANSLATE_URL=https://translate.mstdn.social/translate
LIBRETRANSLATE_API_KEY=
MYMEMORY_EMAIL=

# Brevo transactional email.
# Set EMAIL_PROVIDER=gmail to use Google/Gmail SMTP instead of Brevo.
EMAIL_PROVIDER=brevo
EMAIL_SENDER_NAME=Allberdov Allberd
EMAIL_SENDER_EMAIL=allberdovallberd@gmail.com
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_URLS=
BREVO_TIMEOUT_MS=45000
BREVO_IP_FAMILY=4
BREVO_SMTP_KEY=
BREVO_SMTP_PASSWORD=
BREVO_SMTP_LOGIN=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SENDER_NAME=Allberdov Allberd
BREVO_SENDER_EMAIL=allberdovallberd@gmail.com
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=
GMAIL_SENDER_NAME=
GMAIL_SENDER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_NAME=
SMTP_SENDER_EMAIL=
